# Copy to .env and fill in what you need: cp .env.example .env

# offline = deterministic run, no API keys needed (use this for automated evaluation)
# live    = real Gemini models through Google ADK (needs GOOGLE_API_KEY)
GHOST_MODE=offline

# Live mode: free key from https://aistudio.google.com/apikey
GOOGLE_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# Gemini model IDs for each role. Pick from https://ai.google.dev/gemini-api/docs/models
# and pin the tested IDs here once chosen.
GEMINI_PRO_MODEL=
GEMINI_FLASH_MODEL=
GEMINI_LIVE_MODEL=

# Live mode requires Maps. Offline mode uses explicitly simulated route fixtures.
GOOGLE_MAPS_API_KEY=

# PII guardrail: redact (default) replaces phone/email/Aadhaar/card/PAN/UPI with
# [REDACTED:KIND] and continues; block rejects such requests with HTTP 422.
GHOST_PII_MODE=redact

# UI/backend: use one API worker. Offline demo token; replace for live mode.
GHOST_API_TOKEN=ghost-demo
GHOST_API_URL=http://127.0.0.1:8000
GHOST_UI_ORIGIN=http://localhost:3000
GHOST_DATABASE=runs/ghost.sqlite
# collected = teammate's data/ pack; builtin = minimal developer fixture
GHOST_DATASET=collected
GHOST_DATA_DIR=data
# Optional normalized custom seed; overrides GHOST_DATASET. See docs/BACKEND.md.
GHOST_SEED_FILE=
GHOST_MCP_URL=http://127.0.0.1:8001/mcp
GHOST_CARRIER_URL=http://127.0.0.1:8002

# Live Workspace calls use user OAuth. Never put tokens/client secrets in Git.
GOOGLE_OAUTH_TOKEN_FILE=
GOOGLE_SHEET_ID=
GOOGLE_CALENDAR_ID=
GOOGLE_DEMO_RECIPIENT=
