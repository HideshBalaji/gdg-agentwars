# Copy to .env.local if you need to override defaults: cp .env.example .env.local

# Start in "demo" (scripted, no backend) or "live" (FastAPI backend via the Vite proxy).
VITE_DEFAULT_MODE=demo

# Bearer token the backend expects (offline default is ghost-demo).
VITE_API_TOKEN=ghost-demo

# Leave empty to use the Vite proxy to http://127.0.0.1:8000 (set GHOST_API to change the target).
VITE_API_URL=
